# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/landing-construmia
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@construmia.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Construmia <team@construmia.com>

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payphone (Cajita de Pagos) ---
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# --- Leads ---
# Webhook unico del CRM: recibe el contacto y luego la cualificacion.
LEAD_WEBHOOK_URL=
# Correo interno que recibe el aviso de cada lead.
LEAD_NOTIFY_EMAIL=
